{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "serve:dev",
			"detail": "Runs the Hono dev server with bun --hot",
			"type": "npm",
			"script": "start:dev",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "deploy",
			"detail": "Pushes the master branch to dokku remote",
			"type": "npm",
			"script": "deploy",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "deploy:env",
			"detail": "Sets Dokku environment variables for release-o-matic",
			"type": "npm",
			"script": "deploy-env",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "typecheck:watch",
			"detail": "Runs tsc --watch to find type errors during development",
			"type": "npm",
			"script": "typecheck-dev",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": ["$tsc-watch"],
			"isBackground": true
		},
		{
			"label": "typecheck",
			"detail": "Runs tsc once to find type errors",
			"type": "shell",
			"command": "bunx tsc --noEmit",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": ["$tsc"]
		},
		{
			"label": "rebuild:packages",
			"detail": "Runs build for all workspace packages",
			"type": "npm",
			"script": "rebuild:packages",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "test",
			"detail": "Runs all vitest tests once",
			"type": "npm",
			"script": "test",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "test:watch",
			"detail": "Runs vitest in watch mode",
			"type": "npm",
			"script": "test:watch",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "Start Dev",
			"detail": "Starts both dev server and TS compiler in watch mode",
			"dependsOn": ["Start Dev Server", "TypeScript Watch"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$tsc-watch"]
		}
	]
}
